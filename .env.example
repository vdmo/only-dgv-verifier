# DGV Gate — production environment template
# Copy to .env next to docker-compose.gate.yml and fill every REQUIRED value.
# Never commit a filled .env.

# ---------- REQUIRED ----------

# Postgres password. REQUIRED — do not deploy with the compose default.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Admin API key guarding /config/*, /policies/*, /revoke, /agents/* writes.
# REQUIRED — the gate refuses admin calls when unset only if it can; treat
# unset as "admin surface disabled" and always set it.
# Generate: openssl rand -hex 32
DGV_ADMIN_KEY=

# ---------- Identity (OIDC / JWT) ----------
# Pick exactly one mode. When any of these is set, /govern and /execute
# require a Bearer JWT whose `sub` is the acting agent_id.

# Mode A — OIDC discovery (recommended). The gate fetches
#   {DGV_OIDC_ISSUER}/.well-known/openid-configuration at startup and uses
#   the advertised jwks_uri + issuer for RS256 validation.
# Example: https://your-tenant.us.auth0.com/  or  https://accounts.google.com
DGV_OIDC_ISSUER=

# Mode B — direct JWKS URL (skip discovery).
# DGV_JWT_JWKS_URL=https://your-idp/.well-known/jwks.json

# Mode C — pinned RS256 public key (single-issuer, no rotation).
# DGV_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Mode D — shared HS256 secret. Dev only; do not use in production.
# DGV_JWT_SECRET=

# Token claims — strongly recommended with any mode above.
DGV_JWT_ISSUER=
DGV_JWT_AUDIENCE=

# JWKS cache lifetime (default 300000 ms). Lower = faster key-rotation pickup.
DGV_JWKS_CACHE_TTL_MS=300000

# ---------- Networking ----------

# Public origins allowed to call the gate cross-origin. List your actual
# app origins; "*" is never correct in production.
DGV_CORS_ORIGINS=https://app.example.com

# Rate limit per client IP (default 100 req / 60 s).
DGV_RATE_LIMIT_MAX=100
DGV_RATE_LIMIT_WINDOW_MS=60000

# ---------- Resilience ----------

# Partition behaviour when Postgres is unreachable.
#   fail_closed (default): deny new /govern and /execute — safe.
#   fail_open:             allow but warn — dev only.
DGV_PARTITION_POLICY=fail_closed

# Signed revocation gossip between peer gates.
# Comma-separated peer base URLs this node pushes revocations to:
# DGV_PEERS=https://gate-b.internal:7878,https://gate-c.internal:7878
# Comma-separated hex Ed25519 verifying keys accepted as gossip signers
# (the node signs with DGV_SIGNING_KEY; peers list each other's keys):
# DGV_GOSSIP_KEYS=

# Quorum consensus for revocation at execution time T₁ (Option B).
# When set, continuing authority at /execute requires signed positive confirmation
# from a quorum of cluster nodes. An isolated node fails closed under partition.
# Comma-separated peer base URLs in the quorum cluster:
# DGV_QUORUM_PEERS=https://gate-b.internal:7878,https://gate-c.internal:7878
# Required quorum count (default: strict majority = (1 + peers)/2 + 1):
# DGV_QUORUM_SIZE=2
# Per-peer network timeout in milliseconds (default: 1500):
# DGV_QUORUM_TIMEOUT_MS=1500

# Merkle anti-entropy background synchronization (Option C).
# Periodic interval in seconds to compare 16-bucket Merkle prefix trees with peers
# and automatically reconcile divergent records (0 = disabled, e.g. 30):
# DGV_ANTI_ENTROPY_SECS=30

# Delegation depth cap (default 3). A token chain longer than this is denied.
DGV_MAX_DELEGATION_DEPTH=3

# Circuit breaker for repeated downstream failures (defaults shown).
# DGV_CIRCUIT_BREAKER_THRESHOLD=5
# DGV_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# DGV_CIRCUIT_BREAKER_DISABLED=1   # disables — not recommended

# ---------- Observability ----------

# "json" for structured logs (ship to your log pipeline), "pretty" for console.
DGV_LOG_FORMAT=json

# ---------- Optional semantic verifier ----------
# External webhook asked to analyse /govern justifications. Off when unset.
# DGV_SEMANTIC_VERIFIER_URL=https://verifier.internal/check
# Fail closed when the verifier errors/times out (default: fail open + warn).
# DGV_SEMANTIC_FAIL_CLOSED=1
